# =============================================================================
# SIGNALING SERVER ENVIRONMENT VARIABLES
# =============================================================================
# These are used by the Cloudflare Worker for WebRTC signaling
# Set these via wrangler secret or GitHub Actions
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS
# -----------------------------------------------------------------------------

# JWT signing secret for authenticating WebRTC connections
# Generate with: openssl rand -hex 32
# This MUST match the SIGNALING_SECRET in apps/web/.env
SIGNALING_SECRET=dev-secret-change-in-production

# Allowed origins for CORS (comma-separated)
# Example: https://locanote.pages.dev,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# -----------------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Maximum connections per room (default: 50)
# MAX_CONNECTIONS_PER_ROOM=50

# Maximum connections per IP (default: 10)
# MAX_CONNECTIONS_PER_IP=10

# Message rate limit per minute (default: 100)
# MESSAGE_RATE_LIMIT=100

# Connection timeout in milliseconds (default: 30 minutes)
# CONNECTION_TIMEOUT=1800000

# Maximum message size in bytes (default: 64KB)
# MAX_MESSAGE_SIZE=65536
