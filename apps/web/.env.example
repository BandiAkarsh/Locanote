# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# SIGNALING SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# JWT signing secret for WebRTC authentication
# Generate with: openssl rand -hex 32
SIGNALING_SECRET=dev-secret-change-in-production

# WebSocket URL for local development
# Use ws:// for HTTP, wss:// for HTTPS
SIGNALING_URL=ws://localhost:8787

# -----------------------------------------------------------------------------
# PUBLIC CONFIGURATION (accessible in browser)
# -----------------------------------------------------------------------------

# Public URL of the app (used for CORS, sharing, etc.)
PUBLIC_APP_URL=http://localhost:5173

# Public WebSocket URL for signaling
# This must match SIGNALING_URL but with public protocol
PUBLIC_SIGNALING_URL=ws://localhost:8787

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -----------------------------------------------------------------------------

# Cloudflare Analytics (optional)
# PUBLIC_ANALYTICS_ID=

# Sentry error tracking (optional)
# PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL: AI FEATURES
# -----------------------------------------------------------------------------

# Enable AI features (true/false)
# PUBLIC_ENABLE_AI=true

# AI Model configuration
# PUBLIC_AI_MODEL_PATH=/models

# -----------------------------------------------------------------------------
# OPTIONAL: FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable collaboration features
# PUBLIC_ENABLE_COLLABORATION=true

# Enable offline mode
# PUBLIC_ENABLE_OFFLINE=true
